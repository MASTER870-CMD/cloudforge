# Environment
NODE_ENV=development
PORT=3000

# App
APP_VERSION=1.0.0

# CORS (comma-separated origins for production)
CORS_ORIGIN=http://localhost:3000

# Database (SQLite file path)
DB_PATH=./data/cloudforge.db

